{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/biofig-evidence/output-schema-2.1.json",
  "title": "Biofig Evidence Output 2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extraction_status", "document", "figure", "sources", "panels", "review_required", "review_reasons", "source_coverage", "conflicts", "validation"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "extraction_status": {"enum": ["complete", "partial", "failed"]},
    "document": {"$ref": "#/$defs/document"},
    "figure": {"$ref": "#/$defs/figure"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "panels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/panel"}},
    "review_required": {"type": "boolean"},
    "review_reasons": {"type": "array", "items": {"$ref": "#/$defs/reviewReason"}},
    "source_coverage": {"type": "array", "items": {"$ref": "#/$defs/sourceCoverage"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "nullableNumber": {"type": ["number", "null"]},
    "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "bbox": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1", "coordinate_space"],
      "properties": {
        "x0": {"type": "number"}, "y0": {"type": "number"},
        "x1": {"type": "number"}, "y1": {"type": "number"},
        "coordinate_space": {"enum": ["pdf_points", "pixels", "normalized_0_1"]}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "doi", "source_file", "source_sha256"],
      "properties": {
        "title": {"$ref": "#/$defs/nullableString"},
        "doi": {"$ref": "#/$defs/nullableString"},
        "source_file": {"$ref": "#/$defs/nullableString"},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "figure": {
      "type": "object", "additionalProperties": false,
      "required": ["figure_id", "pdf_page", "printed_page", "caption", "render_dpi", "image_file"],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "pdf_page": {"type": ["integer", "null"], "minimum": 1},
        "printed_page": {"type": ["string", "integer", "null"]},
        "caption": {"$ref": "#/$defs/nullableString"},
        "render_dpi": {"type": ["integer", "null"], "minimum": 1},
        "image_file": {"$ref": "#/$defs/nullableString"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "content_status", "locator", "quote"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["image", "caption", "results", "methods", "supplement", "metadata", "user"]},
        "content_status": {"enum": ["present", "partial", "unreadable", "missing"]},
        "locator": {
          "type": "object", "additionalProperties": false,
          "required": ["file", "page", "panel", "paragraph", "bbox"],
          "properties": {
            "file": {"$ref": "#/$defs/nullableString"},
            "page": {"type": ["integer", "string", "null"]},
            "panel": {"$ref": "#/$defs/nullableString"},
            "paragraph": {"$ref": "#/$defs/nullableString"},
            "bbox": {"$ref": "#/$defs/bbox"}
          }
        },
        "quote": {"$ref": "#/$defs/nullableString"}
      }
    },
    "factor": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "level", "value", "unit", "role", "evidence_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "level": {"$ref": "#/$defs/nullableString"},
        "value": {"$ref": "#/$defs/nullableNumber"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "role": {"enum": ["independent", "control", "fixed", "time", "context"]},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "factors", "controls", "fixed_conditions", "protocol", "time"],
      "properties": {
        "system": {"$ref": "#/$defs/nullableString"},
        "factors": {"type": "array", "items": {"$ref": "#/$defs/factor"}},
        "controls": {"type": "array", "items": {"$ref": "#/$defs/factor"}},
        "fixed_conditions": {"type": "array", "items": {"$ref": "#/$defs/factor"}},
        "protocol": {"$ref": "#/$defs/nullableString"},
        "time": {"$ref": "#/$defs/nullableString"}
      }
    },
    "axis": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "label", "unit", "scale", "range", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["x", "y", "y2", "color", "size", "facet"]},
        "label": {"$ref": "#/$defs/nullableString"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "scale": {"enum": ["linear", "log", "categorical", "ordinal", "unknown", "not_applicable"]},
        "range": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {"min": {"$ref": "#/$defs/nullableNumber"}, "max": {"$ref": "#/$defs/nullableNumber"}}
        },
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "series": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "axis_ids", "visual_encoding", "mapping_status", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "axis_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "visual_encoding": {"$ref": "#/$defs/nullableString"},
        "mapping_status": {"enum": ["direct_label", "legend_mapped", "not_categorical", "ambiguous"]},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "value": {
      "type": "object", "additionalProperties": false,
      "required": ["raw", "numeric", "unit", "qualifier", "status", "tolerance"],
      "properties": {
        "raw": {"$ref": "#/$defs/nullableString"},
        "numeric": {"$ref": "#/$defs/nullableNumber"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "qualifier": {"enum": ["exact", "approximately", "less_than", "greater_than", "range", "unknown", "not_applicable"]},
        "status": {"enum": ["exact", "approximate", "bounded", "not_recoverable", "not_applicable"]},
        "tolerance": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "lower", "upper", "raw", "evidence_ids"],
      "properties": {
        "kind": {"enum": ["sd", "sem", "ci", "range", "unknown", "none"]},
        "lower": {"$ref": "#/$defs/nullableNumber"},
        "upper": {"$ref": "#/$defs/nullableNumber"},
        "raw": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "series_id", "x", "y", "error", "at_conditions", "evidence_ids", "confidence", "confidence_rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "series_id": {"type": ["string", "null"]},
        "x": {"$ref": "#/$defs/value"},
        "y": {"$ref": "#/$defs/value"},
        "error": {"$ref": "#/$defs/error"},
        "at_conditions": {"type": "array", "items": {"$ref": "#/$defs/factor"}},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "confidence_rationale": {"type": "string", "minLength": 1}
      }
    },
    "derivedInput": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "value", "unit", "tolerance", "evidence_ids"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "value": {"type": "number"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "tolerance": {"type": ["number", "null"], "minimum": 0},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "derivedValue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "formula", "inputs", "reported", "calculated", "unit", "tolerance", "comparison_status", "relative_difference", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/derivedInput"}},
        "reported": {"$ref": "#/$defs/nullableNumber"},
        "calculated": {"$ref": "#/$defs/nullableNumber"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "tolerance": {"type": "number", "minimum": 0},
        "comparison_status": {"enum": ["consistent", "conflict", "not_comparable"]},
        "relative_difference": {"$ref": "#/$defs/nullableNumber"},
        "rounding_interval_check": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["status", "precision", "input_intervals", "calculated_interval", "reported_inside_interval", "notes", "evidence_ids"],
          "properties": {
            "status": {"enum": ["evaluated", "not_evaluable", "not_applicable"]},
            "precision": {"type": ["integer", "null"], "minimum": 0, "maximum": 12},
            "input_intervals": {
              "type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["symbol", "lower", "upper", "evidence_ids"],
                "properties": {
                  "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
                  "lower": {"type": "number"},
                  "upper": {"type": "number"},
                  "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
                }
              }
            },
            "calculated_interval": {
              "type": ["object", "null"], "additionalProperties": false,
              "required": ["lower", "upper"],
              "properties": {"lower": {"type": "number"}, "upper": {"type": "number"}}
            },
            "reported_inside_interval": {"type": ["boolean", "null"]},
            "notes": {"type": "string", "minLength": 1},
            "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
          }
        },
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "endpoint", "axis_id", "unit", "value_type", "origin", "extraction_method", "numeric_status", "points", "derived_values"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "axis_id": {"type": ["string", "null"]},
        "unit": {"$ref": "#/$defs/nullableString"},
        "value_type": {"enum": ["absolute", "ratio", "percentage", "normalized", "qualitative", "count", "unknown"]},
        "origin": {"enum": ["direct_measurement", "calculated", "author_reported", "unknown", "not_applicable"]},
        "extraction_method": {"enum": ["direct_report", "text_transcription", "image_estimate", "calculated_from_evidence", "unknown", "not_applicable"]},
        "numeric_status": {"enum": ["complete", "partial", "not_requested", "not_applicable", "failed"]},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "derived_values": {"type": "array", "items": {"$ref": "#/$defs/derivedValue"}}
      }
    },
    "sampleSize": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scope", "value", "unit_of_analysis", "replicate_type", "independent_experiments", "raw", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "value": {"type": ["integer", "null"], "minimum": 0},
        "unit_of_analysis": {"$ref": "#/$defs/nullableString"},
        "replicate_type": {"enum": ["biological", "technical", "independent_experiment", "field", "device", "specimen", "unknown", "not_reported"]},
        "independent_experiments": {"type": ["integer", "null"], "minimum": 0},
        "raw": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "statistics": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "sample_sizes", "error_bar", "tests", "p_values", "significance_symbols", "significance_mapping", "error_propagation", "notes"],
      "properties": {
        "scope": {"enum": ["descriptive", "inferential", "not_applicable", "unclear"]},
        "sample_sizes": {"type": "array", "items": {"$ref": "#/$defs/sampleSize"}},
        "error_bar": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "raw", "applies_to"],
          "properties": {
            "kind": {"enum": ["sd", "sem", "ci", "range", "none", "unknown"]},
            "raw": {"$ref": "#/$defs/nullableString"},
            "applies_to": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "tests": {"type": "array", "items": {"type": "string"}},
        "p_values": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["raw", "numeric", "relation", "comparison", "evidence_ids"],
            "properties": {
              "raw": {"$ref": "#/$defs/nullableString"},
              "numeric": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "relation": {"enum": ["=", "<", ">", "<=", ">=", "unknown"]},
              "comparison": {"$ref": "#/$defs/nullableString"},
              "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
            }
          }
        },
        "significance_symbols": {"type": "array", "items": {"type": "string"}},
        "significance_mapping": {"$ref": "#/$defs/nullableString"},
        "error_propagation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "method", "evidence_ids"],
          "properties": {
            "status": {"enum": ["reported", "not_reported", "not_applicable", "unclear"]},
            "method": {"$ref": "#/$defs/nullableString"},
            "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "qualitativeObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "observation", "feature", "comparison", "evidence_ids", "confidence", "confidence_rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "feature": {"$ref": "#/$defs/nullableString"},
        "comparison": {"$ref": "#/$defs/nullableString"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "confidence_rationale": {"type": "string", "minLength": 1}
      }
    },
    "processStep": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "label", "parameters", "predecessor_ids", "evidence_ids", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/factor"}},
        "predecessor_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim", "claim_type", "epistemic_status", "confidence", "confidence_rationale", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "claim_type": {"enum": ["descriptive_trend", "difference", "association", "significance", "mechanism", "localization", "morphology", "method", "limitation", "other"]},
        "epistemic_status": {"enum": ["observed", "reported", "inferred"]},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "confidence_rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "reviewReason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "field_path", "detail", "suggested_action", "evidence_ids"],
      "properties": {
        "code": {"enum": ["MISSING_CAPTION", "UNREADABLE_AXIS", "UNREADABLE_LEGEND", "LOW_IMAGE_QUALITY", "VALUE_NOT_RECOVERABLE", "MISSING_STATISTICS", "UNMAPPED_SIGNIFICANCE", "AMBIGUOUS_COMPARISON", "SOURCE_CONFLICT", "UNSUPPORTED_FIGURE", "AMBIGUOUS_CONDITION", "AMBIGUOUS_SERIES_MAPPING", "MISSING_DENOMINATOR", "UNSPECIFIED_ERROR_PROPAGATION", "MISSING_SCALE_BAR", "OTHER"]},
        "severity": {"enum": ["critical", "major", "minor"]},
        "field_path": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "suggested_action": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "sourceCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "scope", "fact_summary", "status", "field_paths", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "scope": {"enum": ["figure_context", "experimental_conditions", "results", "statistics", "other"]},
        "fact_summary": {"type": "string", "minLength": 1},
        "status": {"enum": ["consumed", "partially_consumed", "not_consumed", "not_applicable", "unavailable"]},
        "field_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "panel": {
      "type": "object", "additionalProperties": false,
      "required": ["panel_id", "panel_type", "location", "chart_explanation", "experiment", "axes", "series", "measurements", "qualitative_observations", "process_steps", "statistics", "claims", "confidence", "confidence_rationale", "review_required", "review_reasons"],
      "properties": {
        "panel_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*$"},
        "panel_type": {"enum": ["line", "bar", "scatter", "box", "violin", "dose_response", "time_course", "dual_axis", "heatmap", "microscopy", "histology", "oct", "western_blot", "flow_cytometry", "image_series", "process_diagram", "schematic", "mixed", "other"]},
        "location": {
          "type": "object", "additionalProperties": false,
          "required": ["source_id", "pdf_page", "panel_label", "bbox"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "pdf_page": {"type": ["integer", "null"], "minimum": 1},
            "panel_label": {"type": "string", "minLength": 1},
            "bbox": {"$ref": "#/$defs/bbox"}
          }
        },
        "chart_explanation": {"type": "string", "minLength": 1},
        "experiment": {"$ref": "#/$defs/experiment"},
        "axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}},
        "series": {"type": "array", "items": {"$ref": "#/$defs/series"}},
        "measurements": {"type": "array", "items": {"$ref": "#/$defs/measurement"}},
        "qualitative_observations": {"type": "array", "items": {"$ref": "#/$defs/qualitativeObservation"}},
        "process_steps": {"type": "array", "items": {"$ref": "#/$defs/processStep"}},
        "statistics": {"$ref": "#/$defs/statistics"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "confidence_rationale": {"type": "string", "minLength": 1},
        "review_required": {"type": "boolean"},
        "review_reasons": {"type": "array", "items": {"$ref": "#/$defs/reviewReason"}}
      }
    },
    "reportedValue": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "value", "unit", "source_ids"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/nullableNumber"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "source_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "field_paths", "description", "reported_values", "calculation", "relative_difference", "resolution", "source_ids", "review_action"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["source_text", "image_text", "calculation", "unit", "direction", "other"]},
        "field_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1},
        "reported_values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reportedValue"}},
        "calculation": {"$ref": "#/$defs/nullableString"},
        "relative_difference": {"$ref": "#/$defs/nullableNumber"},
        "resolution": {"enum": ["unresolved", "reported_with_caveat", "resolved_by_primary_source"]},
        "source_ids": {"$ref": "#/$defs/evidenceIds"},
        "review_action": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_passed", "semantic_passed", "report_generated", "validator", "validated_at"],
      "properties": {
        "schema_passed": {"type": "boolean"},
        "semantic_passed": {"type": "boolean"},
        "report_generated": {"type": "boolean"},
        "validator": {"type": "string", "minLength": 1},
        "validated_at": {"$ref": "#/$defs/nullableString"}
      }
    }
  }
}
